---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const blogEntries = await getCollection('blog');
	return blogEntries.map(entry => ({
		params: { slug: entry.slug }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(id: string, pubDate?: Date) {
	const date = pubDate || new Date(id.split('-').slice(0, 3).join('-'));
	return date.toLocaleDateString('es-ES', {
		year: 'numeric',
		month: 'long',
		day: 'numeric'
	});
}
---

<Layout title={`${entry.data.title} | Blog`}>
	<article class="post-content">
		<div class="post-header">
			<a href="/blog" class="back-link">&larr; Volver al Blog</a>
			<div class="post-meta">
				{formatDate(entry.id, entry.data.pubDate)}
				{entry.data.author && <span class="author"> • Por {entry.data.author}</span>}
			</div>
			<h1>{entry.data.title}</h1>
			{entry.data.heroImage && <img src={entry.data.heroImage} alt="" class="hero-image" />}
		</div>
		
		<div class="markdown-body">
			<Content />
		</div>

		<div class="post-footer">
			<a href="/blog" class="back-link">&larr; Volver al Blog</a>
		</div>
	</article>
</Layout>

<style is:global>
	.post-content {
		max-width: 100%;
		margin: 1rem 0;
		background: rgba(30, 41, 59, 0.3);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 1rem;
		padding: 2rem 3rem;
	}
	.post-header {
		margin-bottom: 3rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding-bottom: 2rem;
	}
	.back-link {
		color: var(--accent-light);
		text-decoration: none;
		font-weight: 500;
		display: inline-block;
		margin-bottom: 1.5rem;
	}
	.post-meta {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.post-header h1 {
		font-size: 3rem;
		margin: 0;
		line-height: 1.1;
	}
	.hero-image {
		width: 100%;
		border-radius: 1rem;
		margin-top: 2rem;
	}
	.markdown-body {
		line-height: 1.8;
		font-size: 1.1rem;
		color: #e2e8f0;
	}
	.markdown-body h2 {
		font-size: 2rem;
		margin-top: 3rem;
		margin-bottom: 1.5rem;
		color: white;
	}
	.markdown-body h3 {
		font-size: 1.5rem;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: white;
	}
	.markdown-body p {
		margin-bottom: 1.5rem;
	}
	.markdown-body ul, .markdown-body ol {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}
	.markdown-body li {
		margin-bottom: 0.5rem;
	}
	.markdown-body code {
		background: rgba(15, 23, 42, 0.8);
		padding: 0.2rem 0.4rem;
		border-radius: 0.3rem;
		font-family: 'Fira Code', monospace;
		font-size: 0.9em;
	}
	.markdown-body pre {
		background: #0f172a !important;
		padding: 1.5rem;
		border-radius: 1rem;
		overflow-x: auto;
		margin: 2rem 0;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}
	.markdown-body img {
		max-width: 100%;
		border-radius: 0.75rem;
		margin: 2rem 0;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}
	.post-footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	@media (max-width: 768px) {
		.post-content {
			padding: 1rem 1.25rem;
			margin: 0.5rem 0;
		}
		.post-header h1 {
			font-size: 2rem;
		}
	}
</style>
