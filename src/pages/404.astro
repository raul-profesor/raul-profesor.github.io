---
import Layout from '../layouts/Layout.astro';
import * as Icons from 'lucide-astro';
---

<Layout title="404 - Página no encontrada">
	<div class="error-container">
		<div class="icon-box">
			<Icons.ShieldAlert size={80} />
		</div>
		<h1 class="error-code">404</h1>
		<h2 class="error-title">Recurso no encontrado</h2>
		<p class="error-message">Parece que el módulo o sección al que intentas acceder ha sido movido o no existe.</p>
		<a href="/" class="home-button">
			<Icons.Home size={20} />
			Volver al Dashboard
		</a>
	</div>
</Layout>

<style>
	.error-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 70vh;
		text-align: center;
		padding: 2rem;
	}
	.icon-box {
		color: var(--accent-light);
		margin-bottom: 2rem;
		animation: pulse 2s infinite;
	}
	@keyframes pulse {
		0% { transform: scale(1); opacity: 1; }
		50% { transform: scale(1.1); opacity: 0.8; }
		100% { transform: scale(1); opacity: 1; }
	}
	.error-code {
		font-size: 8rem;
		line-height: 1;
		margin: 0;
		background: linear-gradient(to right, #6366f1, #a855f7);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		font-weight: 900;
	}
	.error-title {
		font-size: 2.5rem;
		margin: 0.5rem 0 1.5rem 0;
		color: white;
	}
	.error-message {
		font-size: 1.25rem;
		color: var(--text-muted);
		max-width: 500px;
		margin-bottom: 3rem;
	}
	.home-button {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		background: var(--accent-gradient);
		color: black;
		padding: 1rem 2rem;
		border-radius: 3rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s, box-shadow 0.2s;
		box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);
	}
	.home-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(168, 85, 247, 0.6);
	}
</style>
