---
import * as Icons from 'lucide-astro';

interface Props {
	title: string;
	url: string;
	icon: string;
	status: 'new' | 'old' | 'deprecated';
	color?: string;
}

const { title, url, icon, status, color } = Astro.props;

// Helper to get the Lucide component by name
const IconComponent = (Icons as any)[icon.charAt(0).toUpperCase() + icon.slice(1).replace(/-([a-z])/g, (g) => g[1].toUpperCase())] || Icons.HelpCircle;

const statusColor = {
	new: '#10b981',
	old: '#f59e0b',
	deprecated: '#ef4444'
};

const dotColor = color ?? statusColor[status];
---

<a href={url} class="card" target={url.startsWith('http') ? '_blank' : '_self'}>
	<div class="card-inner">
		<div class="icon-container">
			<IconComponent size={24} color="var(--accent-light)" />
		</div>
		<div class="content">
			<span class="status-dot" style={`background-color: ${dotColor}; box-shadow: 0 0 8px ${dotColor}`}></span>
			<h3 class="title">{title}</h3>
		</div>
		<div class="arrow">
			<Icons.ChevronRight size={20} />
		</div>
	</div>
</a>

<style>
	.card {
		display: block;
		background: rgba(30, 41, 59, 0.4);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 1rem;
		padding: 1.25rem;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		position: relative;
		overflow: hidden;
		text-decoration: none;
		color: white;
	}
	.card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(800px circle at var(--mouse-x) var(--mouse-y), rgba(255, 255, 255, 0.06), transparent 40%);
		z-index: 0;
		opacity: 0;
		transition: opacity 0.5s;
	}
	.card:hover {
		transform: translateY(-4px);
		background: rgba(30, 41, 59, 0.6);
		border-color: rgba(255, 255, 255, 0.2);
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
	}
	.card:hover .icon-container {
		transform: scale(1.1);
		background: rgba(136, 58, 234, 0.2);
	}
	.card-inner {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		position: relative;
		z-index: 1;
	}
	.icon-container {
		width: 3rem;
		height: 3rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(15, 23, 42, 0.5);
		border-radius: 0.75rem;
		transition: all 0.3s ease;
	}
	.content {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.title {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 600;
	}
	.status-dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		display: inline-block;
		box-shadow: 0 0 8px var(--status-dot-color);
	}
	.arrow {
		opacity: 0;
		transform: translateX(-10px);
		transition: all 0.3s ease;
		color: var(--accent-light);
	}
	.card:hover .arrow {
		opacity: 1;
		transform: translateX(0);
	}
</style>
